<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Галерея — <%= s.hero_name %></title>
  <meta name="description" content="Фотогалерея депутата Київради <%= s.hero_name %>: робота на окрузі, підтримка Захисників, діяльність у Раді." />
  <meta property="og:title" content="Галерея — <%= s.hero_name %>" />
  <meta property="og:image" content="<%= (gallery[0] && gallery[0].path) || s.og_image %>" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div id="pbar"></div>

<!-- Навбар (посилання ведуть на головну) -->
<nav id="siteNav" class="nav" aria-label="Головна навігація">
  <a class="nav__brand" href="/" aria-label="На головну">
    <span class="mono">ЮТ</span>
    <span class="nav__id">
      <span class="nav__name"><%= s.hero_name %></span>
      <span class="nav__role">Депутат Київради · округ №12</span>
    </span>
  </a>
  <div class="nav__links" id="navLinks">
    <a href="/#about" class="nl">Про депутата</a>
    <a href="/#activity" class="nl">Діяльність</a>
    <a href="/#results" class="nl">Досягнення</a>
    <a href="/#army" class="nl">Захисникам</a>
    <a href="/#news" class="nl">Новини</a>
    <a href="/#contacts" class="nl">Контакти</a>
  </div>
  <a href="/#contacts" class="btn-g nav__cta">Звернутися</a>
  <button class="nav-toggle" id="navToggle" aria-label="Меню" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<main>
  <section class="section section--tint gallery-page">
    <div class="wrap">
      <a class="gallery-back" href="/">← На головну</a>
      <div class="sec-head"><span class="sec-bar"></span><h2>Галерея</h2></div>
      <% if (gallery.length) { %>
        <div class="masonry" id="galleryGrid">
          <% gallery.forEach(function(g){ %>
            <figure class="gitem masonry__item">
              <img class="gzoom" src="<%= g.path %>" alt="<%= esc(g.caption) || 'Фото з галереї' %>" loading="lazy" />
              <% if (g.caption) { %><figcaption class="gcap"><%= g.caption %></figcaption><% } %>
            </figure>
          <% }); %>
        </div>
      <% } else { %>
        <p class="muted">Фотографії додаються в адмінпанелі.</p>
      <% } %>
    </div>
  </section>
</main>

<div class="foot-line"></div>
<footer class="footer">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <span class="mono">ЮТ</span>
      <span class="foot-id"><%= s.hero_name %><br><span>Депутат Київради · округ №12</span></span>
    </div>
    <nav class="foot-links" aria-label="Офіційні посилання">
      <% if (s.kyivrada_url) { %><a href="<%= s.kyivrada_url %>" target="_blank" rel="noopener">Профіль на сайті Київради</a><% } %>
      <% if (s.facebook_url) { %><a href="<%= s.facebook_url %>" target="_blank" rel="noopener">Facebook: Юрій Тихонович</a><% } %>
    </nav>
    <div class="foot-copy">© <%= new Date().getFullYear() %>. Усі права захищені.</div>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
