# ── Копіюйте цей файл у .env і змініть значення ─────────────────────────────
# cp .env.example .env   (Linux/macOS)   |   copy .env.example .env   (Windows)

# Порт, на якому працює сервер
PORT=3000

# Секрет для підпису сесійних cookie. ОБОВ'ЯЗКОВО змініть на довгий випадковий рядок.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Дані для входу в адмінпанель /manager.
# Пароль зберігається у вигляді відкритого рядка ЛИШЕ в .env — на сервері він
# хешується через bcrypt і у такому вигляді порівнюється при вході.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Ставте 1 тільки якщо сайт працює за HTTPS (тоді cookie йдуть лише по захищеному з'єднанню)
SECURE_COOKIES=0
