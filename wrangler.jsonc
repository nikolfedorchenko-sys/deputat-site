// Cloudflare Workers: сайт депутата (див. cf/worker.js).
// Деплой автоматичний: Cloudflare → Workers Builds підключено до цього репозиторію.
{
  "name": "deputat-site",
  "main": "cf/worker.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build-templates.mjs" },
  // Статика з public/ віддається Cloudflare напряму, решту запитів обробляє воркер
  "assets": { "directory": "./public" },
  // Без id: при першому деплої wrangler сам створює базу D1 і сховище KV в акаунті,
  // а далі використовує вже прив'язані. Таблиці й стартовий контент воркер створює сам.
  "d1_databases": [
    { "binding": "DB", "database_name": "deputat_site" }
  ],
  "kv_namespaces": [
    { "binding": "UPLOADS" }
  ],
  "observability": { "enabled": true }
}
